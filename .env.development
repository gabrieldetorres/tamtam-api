# TamTam POS API - development environment
# DUMMY VALUES ONLY. Real secrets go in Render's environment settings
# (or in your local, git-ignored .env file). Never commit real passwords.

APP_NAME="TamTam POS API"
APP_ENV=development
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Supabase Postgres - use the SESSION POOLER details from the Supabase dashboard
DB_CONNECTION=pgsql
DB_HOST=aws-0-REGION.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.DEV_PROJECT_REF
DB_PASSWORD="changeme"

# Supabase project (used later to verify login tokens)
SUPABASE_URL=https://DEV_PROJECT_REF.supabase.co

# Frontend origins allowed to call this API (CORS), comma separated
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Stateless API: no database-backed sessions, cache or queues
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync
